# ==============================================================================
# CampusConnect Supabase Environment Configuration
# ==============================================================================
# Copy this file to .env or .env.local and fill in your Supabase credentials.
# You can find these in your Supabase Dashboard:
# -> Project Settings -> API -> Project URL & Project API Keys (anon public)

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# SECURITY WARNING:
# NEVER place the Supabase 'service_role' secret key in client-side code or this file!
